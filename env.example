# Пример конфигурации. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env НЕ коммитить (он в .gitignore). Здесь только безопасные примеры.

# --- PostgreSQL ---
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=monitoring

# --- Подключение к БД из контейнеров ---
# Логин, пароль и имя базы должны совпадать с POSTGRES_* выше.
# Хост "postgres" это имя сервиса в docker-compose (не localhost).
# Если в пароле есть спецсимволы (@ : / # %), их нужно закодировать (URL-encoding).
DATABASE_URL=postgresql+psycopg://monitoring:change-me-db-password@postgres:5432/monitoring
DATABASE_DSN=postgresql://monitoring:change-me-db-password@postgres:5432/monitoring

# --- Backend ---
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000

# --- Orchestrator ---
ORCHESTRATOR_PORT=8100
# Токен, по которому агенты авторизуются на сервере
AGENT_API_KEY=change-me-agent-key

# --- BFF (вход в веб-панель) ---
BFF_PORT=8200
JWT_SECRET=change-me-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Frontend ---
# Адрес BFF, как его видит браузер
VITE_API_URL=http://localhost:8200
