# PostgreSQL
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_DB=monitoring
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Для запуска backend вне Docker замените host на localhost.
DATABASE_URL=postgresql+psycopg://monitoring:monitoring@postgres:5432/monitoring

# Orchestrator
ORCHESTRATOR_PORT=8100
BACKEND_URL=http://backend:8000
AGENT_API_KEY=change-me-agent-key

# BFF
BFF_PORT=8200
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Frontend (используется при сборке образа)
VITE_API_URL=http://localhost:8200
